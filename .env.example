# Telegram Bot API (required)
TELEGRAM_BOT_TOKEN=replace_with_the_bot_token
# Optional HTTP/SOCKS proxy for Telegram Bot API traffic.
# TELEGRAMAIL_BOT_API_PROXY=http://192.168.123.250:7890
# Optional HTTP/HTTPS/SOCKS5 proxy for IMAP and SMTP traffic.
# TELEGRAMAIL_MAIL_PROXY=http://192.168.123.250:7890
# Public HTTPS origin used for the Mini App and Telegram webhook.
WEB_BASE_URL=https://telegramail.example.com
# Generate a random value (at least 32 characters). Never commit the real value.
SESSION_SECRET=replace_with_a_random_32_character_minimum_session_secret
# Generate a separate random value for Telegram's webhook secret header.
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_webhook_secret
# Initial administrator claim code. It is not a per-device authorization code.
SETUP_CODE=replace_with_a_private_setup_code

# Base64 encoding of exactly 32 random bytes, for example:
# python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
MASTER_KEY=replace_with_a_base64_encoded_32_byte_key

# Named Cloudflare Tunnel token. Keep this value in your untracked .env file.
CLOUDFLARE_TUNNEL_TOKEN=replace_with_the_named_tunnel_token
